# Q-Less Environment Configuration for Vercel & Local Development

# PostgreSQL Connection String (Vercel Postgres, Neon, Supabase, Render, Railway, etc.)
# If provided, Q-Less connects to PostgreSQL via the 'pg' package.
# If omitted or blank, Q-Less falls back to local SQLite ('data/qless.db').
DATABASE_URL=postgres://default:password@ep-sample-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Alternative connection keys supported automatically:
# POSTGRES_URL=postgres://...
# POSTGRES_PRISMA_URL=postgres://...
