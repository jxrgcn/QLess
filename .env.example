# Q-Less Environment Configuration for Vercel & Local Development

# PostgreSQL Connection String (Supabase, Vercel Postgres, Neon, Render, Railway, etc.)
# Q-Less connects to PostgreSQL via the 'pg' (node-postgres) package.
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres?sslmode=require

# Alternative connection keys supported automatically:
# POSTGRES_URL=postgres://...
# POSTGRES_PRISMA_URL=postgres://...
